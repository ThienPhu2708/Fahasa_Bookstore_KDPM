@model IEnumerable<CNPM_LIBRARY_MANAGEMENT.Data.Models.TheLoaiSach>

@{
    ViewData["Title"] = "Quản lý Thể loại Sách";
}

<h1>Quản lý Thể loại Sách</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>
<table class="admin-table">
    <thead>
        <tr>
            <th>
                Mã Thể Loại
            </th>
            <th>
                Tên Thể Loại
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MaTheLoai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TenTheLoai)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" style="color:#dc3545;">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>