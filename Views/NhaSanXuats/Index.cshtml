@model IEnumerable<CNPM_LIBRARY_MANAGEMENT.Data.Models.NhaSanXuat>

@{
    ViewData["Title"] = "Quản lý Nhà sản xuất";
}

<h1>Quản lý Nhà sản xuất</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>
<table class="admin-table">
    <thead>
        <tr>
            <th>
                Mã NSX
            </th>
            <th>
                Tên Nhà sản xuất
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MaNsx)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TenNsx)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" style="color:#dc3545;">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>