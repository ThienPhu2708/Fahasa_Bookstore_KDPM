@model CNPM_LIBRARY_MANAGEMENT.Data.Models.ChatLieu

@{
    ViewData["Title"] = "Xóa";
}

<h1>Xóa Chất liệu</h1>
<h3>Bạn có chắc muốn xóa chất liệu này?</h3>

<div class="admin-details-container">
    <dl class="admin-details-dl">
        <dt>Mã</dt>
        <dd>@Html.DisplayFor(model => model.MaChatLieu)</dd>

        <dt>Tên</dt>
        <dd>@Html.DisplayFor(model => model.TenChatLieu)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="admin-actions">
            <input type="submit" value="Xóa" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại Danh sách</a>
        </div>
    </form>
</div>