@model CNPM_LIBRARY_MANAGEMENT.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="account-container">
    <h2>Đăng nhập</h2>

    <form asp-action="Login" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger" style="text-align:center; margin-bottom: 20px;"></div>

        <div class="form-group">
            <label asp-for="Gmail">Email đăng nhập</label>
            <input asp-for="Gmail" type="email" placeholder="Nhập email của bạn..." />
            <span asp-validation-for="Gmail" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" placeholder="Nhập mật khẩu..." />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group" style="text-align: right; margin-top: -10px; margin-bottom: 20px;">
            <a asp-action="ForgotPassword" asp-controller="Account"
               style="color: #C92127; text-decoration: none; font-size: 14px; font-weight: 600;">
                Quên mật khẩu?
            </a>
        </div>
        <div class="form-group">
            <button type="submit" class="btn-submit">Đăng nhập</button>
        </div>

        <div class="form-footer-links">
            Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
            <br />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}