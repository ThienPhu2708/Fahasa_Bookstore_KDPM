@model CNPM_LIBRARY_MANAGEMENT.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h3 class="auth-title">Quên mật khẩu</h3>

        <p style="text-align: center; color: #666; margin-bottom: 25px; font-size: 14px;">
            Nhập địa chỉ email đã đăng ký của bạn. Chúng tôi sẽ gửi mã xác nhận để đặt lại mật khẩu.
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; text-align: center; border: 1px solid #f5c6cb;">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="form-group">
                <label class="form-label">Email đăng nhập</label>
                <input asp-for="Email" class="custom-input" placeholder="Nhập email của bạn..." />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth">Gửi mã xác nhận</button>
        </form>

        <div style="text-align: center; margin-top: 20px;">
            <a asp-action="Login" style="color: #666; text-decoration: none; font-size: 14px;">
                ← Quay lại <span style="color: #C92127; font-weight: 600;">Đăng nhập</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}