@model CNPM_LIBRARY_MANAGEMENT.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h3 class="auth-title">Đặt lại mật khẩu</h3>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success-custom">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            <div class="form-group">
                <label class="form-label">Email của bạn</label>
                <input asp-for="Email" class="custom-input" readonly />
            </div>

            <div class="form-group">
                <label class="form-label">Mã xác nhận (OTP)</label>
                <input asp-for="Token" class="custom-input" placeholder="Nhập mã 6 số..." />
                <span asp-validation-for="Token" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="custom-input" placeholder="Nhập mật khẩu mới" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" type="password" class="custom-input" placeholder="Nhập lại mật khẩu mới" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth">Xác nhận đổi mật khẩu</button>
        </form>
    </div>
</div>