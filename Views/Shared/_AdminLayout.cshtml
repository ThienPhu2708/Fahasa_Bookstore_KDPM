<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị hệ thống</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <span class="logo-icon">⚡</span>
            <h2>Admin Panel</h2>
        </div>

        <nav class="sidebar-nav">
            <div class="menu-item">
                <a asp-controller="Admin" asp-action="Index" class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    Tổng quan
                </a>
            </div>

            <div class="menu-label">SẢN PHẨM</div>
            <div class="menu-item">
                <a asp-controller="ProductsAdmin" asp-action="Index" class="menu-link">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                    Tất cả sản phẩm
                </a>
            </div>

            <div class="menu-label">QUẢN LÝ SÁCH</div>
            <div class="menu-item">
                <a asp-controller="TheLoaiSaches" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Thể loại sách
                </a>
            </div>
            <div class="menu-item">
                <a asp-controller="TacGias" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Tác giả
                </a>
            </div>
            <div class="menu-item">
                <a asp-controller="NhaXuatBans" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Nhà xuất bản
                </a>
            </div>

            <div class="menu-label">QUẢN LÝ VPP</div>
            <div class="menu-item">
                <a asp-controller="LoaiVpphams" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Loại VPP
                </a>
            </div>
            <div class="menu-item">
                <a asp-controller="ThuongHieus" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Thương hiệu
                </a>
            </div>
            <div class="menu-item">
                <a asp-controller="NhaSanXuats" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Nhà sản xuất
                </a>
            </div>
            <div class="menu-item">
                <a asp-controller="MauSacs" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Màu sắc
                </a>
            </div>
            <div class="menu-item">
                <a asp-controller="ChatLieus" asp-action="Index" class="menu-link">
                    <span class="dot"></span> Chất liệu
                </a>
            </div>

            <div class="sidebar-footer">
                <a asp-controller="Home" asp-action="Index" class="btn-back-home">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Về trang bán hàng
                </a>
            </div>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <h2 class="page-header-title">@ViewData["Title"]</h2>
            <div class="admin-user-profile">
                <img src="https://ui-avatars.com/api/?name=Admin&background=random" alt="Admin" />
                <span>Administrator</span>
            </div>
        </header>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>