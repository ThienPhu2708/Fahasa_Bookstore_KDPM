@model CNPM_LIBRARY_MANAGEMENT.Models.MegaMenuViewModel

<div class="bottom-header">
    <div class="container menu-container">
        <ul class="main-menu">
            <li class="menu-item">
                <a asp-controller="Home" asp-action="Index" class="menu-link">Trang chủ</a>
            </li>

            <li class="menu-item has-dropdown">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="menu-link">
                    Sách <span class="arrow">▼</span>
                </a>
                <div class="dropdown-menu">
                    <div class="dropdown-grid">
                        @foreach (var item in Model.TheLoaiSaches)
                        {
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" asp-route-subCategoryId="@item.Id" class="dropdown-item">
                                @item.TenTheLoai
                            </a>
                        }
                    </div>
                </div>
            </li>

            <li class="menu-item has-dropdown">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="menu-link">
                    Văn phòng phẩm <span class="arrow">▼</span>
                </a>
                <div class="dropdown-menu">
                    <div class="dropdown-grid">
                        @foreach (var item in Model.LoaiVpphams)
                        {
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" asp-route-subCategoryId="@item.Id" class="dropdown-item">
                                @item.TenLoaiVpp
                            </a>
                        }
                    </div>
                </div>
            </li>

            <li class="menu-item">
                <a asp-controller="Product" asp-action="KhuyenMai" class="menu-link">🔥 Khuyến mãi</a>
            </li>
            <li class="menu-item">
                <a asp-controller="Product" asp-action="HangMoiVe" class="menu-link">✨ Hàng mới về</a>
            </li>
        </ul>
    </div>
</div>