<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fahasa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu-type.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/list-product.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-success.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forgot-pass.css" asp-append-version="true" />


	<script src="~/js/site.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
</head>

@inject IHttpContextAccessor HttpContextAccessor

@{
        var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
        var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
        var currentQuery = Context.Request.Query["query"];
}

<body>
    <header class="main-header">
        <nav class="main-nav">
            <a class="nav-logo" asp-controller="Home" asp-action="Index">Fahasa</a>

            <div class="nav-search">
                <form asp-controller="Product" asp-action="Search" method="get">
                    @if (!string.IsNullOrEmpty(Context.Request.Query["categoryId"]))
                    {
                        <input type="hidden" name="categoryId" value="@Context.Request.Query["categoryId"]" />
                    }
                    @if (!string.IsNullOrEmpty(Context.Request.Query["subCategoryId"]))
                    {
                        <input type="hidden" name="subCategoryId" value="@Context.Request.Query["subCategoryId"]" />
                    }

                    <input type="text" name="query" placeholder="Tìm kiếm sản phẩm..." value="@currentQuery" />

                    <button type="submit">
                        <img src="~/images/item/search_icon.png" alt="Search" />
                    </button>
                </form>
            </div>

            <ul class="nav-links">
                <li><a asp-controller="Product" asp-action="Index" class="nav-link-text">Sản phẩm</a></li>

                <li>
                    <a asp-controller="Cart" asp-action="Index" class="nav-cart-link">
                        <span class="icon">
                            <img src="~/images/item/shopping-cart-outline.svg" alt="Cart" />
                        </span>
                        <span class="text">Giỏ hàng</span>
                        @await Component.InvokeAsync("CartWidget")
                    </a>
                </li>

                @if (string.IsNullOrEmpty(username))
                {
                    <li><a asp-controller="Account" asp-action="Login" class="nav-link-text">Đăng nhập</a></li>
                    <li><a asp-controller="Account" asp-action="Register" class="nav-link-text">Đăng ký</a></li>
                }
                else
                {
                    <li class="user-greeting">Chào, <b>@username</b></li>

                    <li>
                        <a asp-controller="Account" asp-action="Profile" class="nav-link-text">Trang cá nhân</a>
                    </li>

                    @if (userRole == "Admin")
                    {
                        <li>
                            <a asp-controller="Admin" asp-action="Index" class="nav-admin-link">Trang Admin</a>
                        </li>
                    }

                    <li><a asp-controller="Account" asp-action="Logout" class="nav-link-text logout-btn">Đăng xuất</a></li>
                }
            </ul>
        </nav>
    </header>
    @await Component.InvokeAsync("MegaMenu")

    <main role="main">
        @RenderBody()
    </main>

    <footer class="fahasa-footer">
        <div class="footer-main-content">
            <div class="container">
                <div class="footer-grid-layout">

                    <div class="footer-col col-company">
                        <div class="footer-logo-wrap">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/fahasa-logo.png" alt="Fahasa.com" width="200">
                        </div>
                        <p class="company-info">
                            Lầu 5, 387-389 Hai Bà Trưng Quận 3 TP HCM<br>
                            Công Ty Cổ Phần Phát Hành Sách TP HCM - FAHASA<br>
                            60 - 62 Lê Lợi, Quận 1, TP. HCM, Việt Nam
                        </p>
                        <p class="company-desc">
                            Fahasa.com nhận đặt hàng trực tuyến và giao hàng tận nơi. KHÔNG hỗ trợ đặt mua và nhận hàng trực tiếp tại văn phòng cũng như tất cả Hệ Thống Fahasa trên toàn quốc.
                        </p>

                        <div class="bct-badge">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/logo-bo-cong-thuong-da-thong-bao.png" alt="Đã thông báo Bộ Công Thương" width="130">
                        </div>

                        <div class="social-icons-list">
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/footer/facebook.png" alt="Facebook"></a>
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/footer/instagram.png" alt="Instagram"></a>
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/footer/youtube.png" alt="Youtube"></a>
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/footer/tumblr.png" alt="Tumblr"></a>
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/footer/twitter.png" alt="Twitter"></a>
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/footer/pinterest.png" alt="Pinterest"></a>
                        </div>

                        <div class="app-store-btns">
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/android.png" alt="Google Play" width="110"></a>
                            <a href="#"><img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/appstore.png" alt="App Store" width="110"></a>
                        </div>
                    </div>

                    <div class="footer-col col-links">
                        <h3>DỊCH VỤ</h3>
                        <ul class="footer-link-list">
                            <li><a href="#">Điều khoản sử dụng</a></li>
                            <li><a href="#">Chính sách bảo mật thông tin cá nhân</a></li>
                            <li><a href="#">Chính sách bảo mật thanh toán</a></li>
                            <li><a href="#">Giới thiệu Fahasa</a></li>
                            <li><a href="#">Hệ thống nhà sách</a></li>
                        </ul>

                        <h3>LIÊN HỆ</h3>
                        <ul class="contact-list">
                            <li>
                                <i class="fa-icon-loc"></i> 60-62 Lê Lợi, Q.1, TP. HCM
                            </li>
                        </ul>

                        <div class="partner-logos row-2">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/ex.png" height="35" alt="Express">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/ninja.png" height="35" alt="Ninja Van">
                        </div>
                        <div class="partner-logos row-2" style="margin-top: 15px;">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/vnpay.png" height="35" alt="VNPAY">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/momopay.png" height="35" alt="Momo">
                        </div>
                    </div>

                    <div class="footer-col col-links">
                        <h3>HỖ TRỢ</h3>
                        <ul class="footer-link-list">
                            <li><a href="#">Chính sách đổi - trả - hoàn tiền</a></li>
                            <li><a href="#">Chính sách bảo hành - bồi hoàn</a></li>
                            <li><a href="#">Chính sách vận chuyển</a></li>
                            <li><a href="#">Chính sách khách sỉ</a></li>
                        </ul>
                        <ul class="contact-list" style="margin-top: 20px;">
                            <li>
                                <i class="fa-icon-mail"></i> cskh@fahasa.com.vn
                            </li>
                        </ul>
                    </div>

                    <div class="footer-col col-links">
                        <h3>TÀI KHOẢN CỦA TÔI</h3>
                        <ul class="footer-link-list">
                            <li><a href="#">Đăng nhập/Tạo mới tài khoản</a></li>
                            <li><a href="#">Thay đổi địa chỉ khách hàng</a></li>
                            <li><a href="#">Chi tiết tài khoản</a></li>
                            <li><a href="#">Lịch sử mua hàng</a></li>
                        </ul>

                        <ul class="contact-list" style="margin-top: 20px;">
                            <li>
                                <i class="fa-icon-phone"></i> <strong style="font-size:16px; color:#333;">1900636467</strong>
                            </li>
                        </ul>

                        <div class="partner-logos row-1" style="margin-top: 20px;">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/vnpost.png" height="40" alt="VNPost">
                        </div>
                        <div class="partner-logos row-2" style="margin-top: 15px;">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/shopeepay.png" height="35" alt="ShopeePay">
                            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/zalopay.png" height="35" alt="ZaloPay">
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="footer-copyright text-center">
            <div class="container">
                <p>Giấy chứng nhận Đăng ký Kinh doanh số 0304132047 do Sở Kế hoạch và Đầu tư Thành phố Hồ Chí Minh cấp ngày 20/12/2005, đăng ký thay đổi lần thứ 10, ngày 20/05/2022.</p>
            </div>
        </div>
    </footer>

    <div id="promoModal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">&times;</button>
            <h3>🎁 Chào mừng bạn đến với Fahasa!</h3>
            <p>Nhập email để nhận ngay mã giảm giá **10%** cho đơn hàng đầu tiên.</p>
            <form class="modal-form">
                <input type="email" placeholder="Email của bạn..." required>
                <button type="submit" class="btn-submit">Nhận mã ngay</button>
            </form>
            <small class="modal-note">Áp dụng cho đơn hàng trên 200.000₫</small>
        </div>
    </div>
    <script>
        AOS.init({
            duration: 1000, // Thời gian chạy hiệu ứng (ms)
            once: true      // Chỉ chạy 1 lần khi cuộn xuống
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>