@model List<CNPM_LIBRARY_MANAGEMENT.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="cart-wrapper">
    <div class="cart-header">
        <h1>Giỏ hàng <span class="cart-count">(@(Model?.Count ?? 0) sản phẩm)</span></h1>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-cart">
            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanese/fahasa/images/checkout_cart/ico_empty_cart.svg" alt="Empty Cart" width="150" />
            <p>Chưa có sản phẩm trong giỏ hàng của bạn.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-shopping">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-list">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        <div class="item-image">
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="~/images/product-images/@item.HinhAnh" alt="@item.TenSanPham" />
                            }
                            else
                            {
                                <img src="~/images/product-images/pj.png" alt="No Image" />
                            }
                        </div>

                        <div class="item-info">
                            <h3 class="item-name">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.SanPhamId">@item.TenSanPham</a>
                            </h3>
                            <p class="item-price">@item.DonGia.ToString("N0") ₫</p>
                        </div>

                        <div class="item-quantity">
                            <form asp-action="UpdateQuantity" method="post" class="qty-form">
                                <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />

                                <div class="qty-group">
                                    <button type="submit" name="soLuong" value="@(item.SoLuong - 1)" class="qty-btn" @(item.SoLuong <= 1 ? "disabled" : "")>-</button>

                                    <input type="number" readonly value="@item.SoLuong" class="qty-display" />

                                    <button type="submit" name="soLuong" value="@(item.SoLuong + 1)" class="qty-btn">+</button>
                                </div>
                            </form>
                        </div>

                        <div class="item-total-price">
                            @item.ThanhTien.ToString("N0") ₫
                        </div>

                        <div class="item-remove">
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />
                                <button type="submit" class="btn-trash" title="Xóa sản phẩm">
                                    🗑️
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-sidebar">
                <div class="summary-card">
                    <h3 class="summary-title">Thanh toán</h3>

                    @{
                        // 1. TÍNH TOÁN LOGIC GIẢM GIÁ (Giống Controller để hiển thị trước)
                        var totalQty = Model.Sum(x => x.SoLuong);
                        var tamTinh = Model.Sum(x => x.ThanhTien);

                        decimal discountRate = 0;
                        string discountLabel = "";

                        if (totalQty > 50)
                        {
                            discountRate = 0.8m;
                            discountLabel = "Siêu Sỉ (Giảm 80%)";
                        }
                        else if (totalQty > 20)
                        {
                            discountRate = 0.4m;
                            discountLabel = "Khách Buôn (Giảm 40%)";
                        }
                        else if (totalQty > 10)
                        {
                            discountRate = 0.2m;
                            discountLabel = "Khách Sỉ (Giảm 20%)";
                        }

                        decimal discountAmount = tamTinh * discountRate;
                        decimal finalTotal = tamTinh - discountAmount;
                    }

                    <div class="summary-row">
                        <span>Tạm tính</span>
                        <span>@tamTinh.ToString("N0") ₫</span>
                    </div>

                    @if (discountAmount > 0)
                    {
                        <div class="summary-row discount-row" style="color: #28a745;">
                            <span>
                                <i class="fas fa-tag"></i> @discountLabel
                            </span>
                            <span>-@discountAmount.ToString("N0") ₫</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" style="font-size: 13px; margin: 10px 0; padding: 8px;">
                            Mẹo: Mua trên <b>10</b> món để được giảm ngay <b>20%</b>!
                            (Hiện tại: @totalQty món)
                        </div>
                    }

                    <hr style="margin: 15px 0; border-top: 1px dashed #ddd;">

                    <div class="summary-row total-row">
                        <span>Thành tiền</span>
                        <span class="final-price">@finalTotal.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-note">
                        (Đã bao gồm VAT nếu có)
                    </div>

                    <a asp-controller="Order" asp-action="Checkout" class="btn-checkout">
                        Tiến hành Đặt hàng
                    </a>

                    <a asp-controller="Product" asp-action="Index" class="link-continue">
                        ← Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    }
</div>