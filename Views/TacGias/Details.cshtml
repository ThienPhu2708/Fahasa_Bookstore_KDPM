@model CNPM_LIBRARY_MANAGEMENT.Data.Models.TacGium

@{
    ViewData["Title"] = "Chi tiết";
}

<h1>Chi tiết Tác giả</h1>

<div class="admin-details-container">
    <dl class="admin-details-dl">
        <dt>Mã</dt>
        <dd>@Html.DisplayFor(model => model.MaTacGia)</dd>

        <dt>Tên</dt>
        <dd>@Html.DisplayFor(model => model.TenTacGia)</dd>
    </dl>

    <div class="admin-actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại Danh sách</a>
    </div>
</div>